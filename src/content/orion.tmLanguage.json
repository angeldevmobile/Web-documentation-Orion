{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orion",
  "scopeName": "source.orion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#shapes" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.orion", "match": "--.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orion",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.template.expression.orion",
              "begin": "\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.orion" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.orion" } },
              "patterns": [{ "include": "#expressions" }]
            },
            {
              "name": "constant.character.escape.orion",
              "match": "\\\\(n|r|t|\\\\|\"|'|0|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            { "name": "invalid.illegal.escape.orion", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.orion",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.orion",
              "match": "\\\\(n|r|t|\\\\|\"|'|0)"
            },
            { "name": "invalid.illegal.escape.orion", "match": "\\\\." }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.orion",
          "match": "\\b(if|else|for|while|return|break|continue|match|in|attempt|handle|with)\\b"
        },
        {
          "name": "keyword.declaration.orion",
          "match": "\\b(fn|const|shape|act|async|use)\\b"
        },
        {
          "name": "keyword.statement.io.orion",
          "match": "\\b(show|ask|read|write|append|spawn|await|serve|route)\\b"
        },
        {
          "name": "keyword.statement.error.orion",
          "match": "\\berror\\b"
        },
        {
          "name": "keyword.statement.ai.orion",
          "match": "\\b(think|learn|sense|adapt|embed|predict|train)\\b"
        },
        {
          "name": "keyword.other.orion",
          "match": "\\b(using|is|on_create|on_event|on_error|me|take|as|with|choices)\\b"
        },
        {
          "name": "keyword.operator.word.orion",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.orion",
          "match": "\\b(int|float|string|bool|list|dict|any|auto|void|number)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.orion", "match": "\\b(yes|no|true|false)\\b" },
        { "name": "constant.language.null.orion", "match": "\\b(null|undefined)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.orion", "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b" },
        { "name": "constant.numeric.hex.orion", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.binary.orion", "match": "\\b0[bB][01]+\\b" },
        { "name": "constant.numeric.octal.orion", "match": "\\b0[oO][0-7]+\\b" },
        { "name": "constant.numeric.integer.orion", "match": "\\b\\d+\\b" }
      ]
    },
    "shapes": {
      "patterns": [
        {
          "match": "\\b(shape)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.orion" },
            "2": { "name": "entity.name.type.orion" }
          }
        },
        {
          "match": "\\b(act)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.orion" },
            "2": { "name": "entity.name.function.orion" }
          }
        },
        {
          "match": "\\b(on_create|on_event|on_error)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.other.constructor.orion" }
          }
        },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{|\\()",
          "captures": {
            "1": { "name": "entity.name.type.orion" }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "begin": "\\b(async\\s+)?(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.orion" },
            "2": { "name": "keyword.declaration.orion" },
            "3": { "name": "entity.name.function.orion" }
          },
          "end": "\\)",
          "patterns": [{ "include": "#function-parameters" }]
        },
        {
          "name": "support.function.builtin.orion",
          "match": "\\b(len|str|type|int|float|bool|keys|values|range|list|abs|max|min|sum|round|floor|ceil|sqrt|pow|upper|lower|strip|reverse|input|assert)(?=\\s*\\()"
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "name": "variable.parameter.orion", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" },
        { "name": "punctuation.separator.type.orion", "match": ":" },
        { "name": "keyword.operator.assignment.orion", "match": "=" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.compound.orion", "match": "(\\*\\*=|\\+=|-=|\\*=|/=|%=)" },
        { "name": "keyword.operator.power.orion",              "match": "\\*\\*" },
        { "name": "keyword.operator.comparison.orion",         "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.logical.orion",            "match": "(&&|\\|\\||!(?!=))" },
        { "name": "keyword.operator.pipe.orion",               "match": "\\|>" },
        { "name": "keyword.operator.arrow.lambda.orion",       "match": "=>" },
        { "name": "keyword.operator.arrow.return.orion",       "match": "->" },
        { "name": "keyword.operator.null-safe.orion",          "match": "\\?\\." },
        { "name": "keyword.operator.range.orion",              "match": "\\.\\.<|\\.\\.\\.|\\.\\." },
        { "name": "keyword.operator.assignment.orion",         "match": "(?<![=!<>+\\-*/%&|])=(?!=)" },
        { "name": "keyword.operator.arithmetic.orion",         "match": "[+\\-*/%]" },
        { "name": "punctuation.separator.orion",               "match": "[,;]" },
        { "name": "punctuation.section.orion",                 "match": "[\\[\\]{}()]" }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.orion" } }
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.constant.orion", "match": "\\b[A-Z][A-Z0-9_]+\\b" },
        { "name": "variable.other.orion",          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
      ]
    },
    "expressions": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#function-calls" },
        { "include": "#variables" }
      ]
    }
  }
}
